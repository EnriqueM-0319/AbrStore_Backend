NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://TU_FRONTEND.vercel.app
CORS_PREVIEW_SUFFIXES=.vercel.app

# Supabase PostgreSQL.
# Pooler recomendado para apps desplegadas. Usa el host/puerto que te da Supabase.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=CAMBIA_ESTA_PASSWORD
DB_DATABASE=postgres
DB_SYNC=true
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

SESSION_SECRET=GENERA_UNA_CLAVE_LARGA_Y_ALEATORIA
