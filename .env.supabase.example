NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
CORS_PREVIEW_SUFFIXES=.vercel.app

# Supabase Postgres pooler recomendado para pruebas de rendimiento desde apps.
# Project Settings > Database > Connection string > Transaction pooler.
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.project_ref
DB_PASSWORD=tu_password_de_base_de_datos
DB_DATABASE=postgres
DB_SYNC=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Usa el mismo secret que en local si quieres conservar formato de sesión.
SESSION_SECRET=cambia-esta-clave-en-produccion

# Opcional: credenciales para seed admin.
SEED_ADMIN_EMAIL=admin@abr.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_FULL_NAME=Administrador ABR
SEED_ADMIN_PHONE=9990000000
SEED_ADMIN_USERNAME=admin
